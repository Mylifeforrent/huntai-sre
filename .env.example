# =============================================================================
# 环境变量模板
# 用法：复制本文件为 .env，填入真实值。严禁将真实密钥提交到 git。
# 安全要求：.env* 已被 .gitignore 忽略；推送到 GitHub 前请确认 Push Protection 已开启。
# =============================================================================

# ---- 运行环境 ----
# 运行环境：development / staging / production
APP_ENV=
# 日志级别：debug / info / warn / error
LOG_LEVEL=

# ---- 数据面（docker compose / 后续 Kubernetes Secret 注入）----
# PostgreSQL 口令（仅编排插值用；业务库只存引用，.env 不入库）
POSTGRES_PASSWORD=

# ---- 可观测（预留；未配置则不上报）----
# Sentry 错误上报 DSN；留空则不上报
SENTRY_DSN=

# ---- 告警通知（预留）----
# 告警 webhook；留空则不发送
ALERT_WEBHOOK_URL=
